<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Library</OutputType>
        <RootNamespace>Replace_Stuff</RootNamespace>
        <AssemblyName>Replace_Stuff</AssemblyName>
        <LangVersion>latest</LangVersion>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <Version>1.7</Version>
    	<GenerateDependencyFile>false</GenerateDependencyFile>
    </PropertyGroup>

    <!-- Debug configuration -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DebugSymbols>true</DebugSymbols>
        <DebugType>portable</DebugType>
        <Optimize>false</Optimize>
        <OutputPath>..\$(Version)\Assemblies\</OutputPath>
        <DefineConstants>DEBUG</DefineConstants>
        <WarningLevel>4</WarningLevel>
        <Prefer32Bit>false</Prefer32Bit>
    </PropertyGroup>

    <!-- Release configuration -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>embedded</DebugType>
        <Optimize>true</Optimize>
        <OutputPath>..\$(Version)\Assemblies\</OutputPath>
        <WarningLevel>4</WarningLevel>
        <Prefer32Bit>false</Prefer32Bit>
    </PropertyGroup>
    
    <!-- NuGet packages -->
    <ItemGroup>
        <PackageReference Include="Krafs.Rimworld.Ref" Version="$(Version).*-*"/>
        <PackageReference Include="Lib.Harmony" Version="2.4.2" ExcludeAssets="runtime"/>
        <PackageReference Include="Krafs.Publicizer" Version="2.1.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <!-- Publicizer custom MSBuild task -->
    <ItemGroup>
        <Publicize Include="Assembly-CSharp"/>
    </ItemGroup>
    <ItemGroup>
        <Folder Include="Properties\"/>
    </ItemGroup>

    <!-- Custom debug launch -->
    <PropertyGroup>
        <StartAction>Program</StartAction>
        <StartProgram>$(SolutionDir)..\..\RimWorldWin64.exe</StartProgram>
    </PropertyGroup>
    <ItemGroup>
        <EditorConfigFiles Remove=".editorconfig"/>
    </ItemGroup>
    <ItemGroup>
        <None Include=".editorconfig"/>
    </ItemGroup>

</Project>
